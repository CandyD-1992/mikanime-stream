{
  "name": "mikanime-stream",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mikan search proxy + wasmnet relay; streaming happens in the browser",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.mjs",
    "build:wasmnet": "node p2p/build-wasmnet.mjs",
    "build:mediabunny": "node p2p/build-mediabunny.mjs",
    "build:frontend": "node p2p/build-wasmnet.mjs && node p2p/build-mediabunny.mjs",
    "flatten": "node scripts/flatten-deps.mjs",
    "debug:browser": "node scripts/browser-debug.mjs",
    "test:transport": "node scripts/test-transport.mjs --port 3010",
    "test:wire": "node scripts/test-wire.mjs --port 3010",
    "test:seed": "node scripts/test-seed.mjs --port 3010"
  },
  "overrides": {
    "uint8-util": "<2.3.0"
  },
  "dependencies": {
    "bencode": "^4.0.1",
    "bittorrent-dht": "^11.0.12",
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "mediabunny": "^1.52.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "esbuild": "^0.28.1",
    "events": "^3.3.0",
    "memory-chunk-store": "^1.3.5",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "playwright": "^1.62.1",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "timers-browserify": "^2.0.12",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "wasmnet": "^0.1.4",
    "webtorrent": ">=2.3.0 <3.0.0"
  }
}
